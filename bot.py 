import os
import random
import requests
import feedparser
import urllib.parse

BOT_TOKEN = os.environ.get('TG_BOT_TOKEN')
CHANNEL_ID = os.environ.get('CHANNEL_ID')

# === КРИПТО НОВОСТИ (Крупные источники) ===
CRYPTO_FEEDS = [
    "https://cointelegraph.com/rss",
    "https://www.coindesk.com/arc/outboundfeeds/rss/",
    "https://decrypt.co/feed",
    "https://theblock.co/rss.xml",
    "https://bitcoinmagazine.com/feed",
    "https://crypto.news/feed/",
    "https://u.today/rss",
    "https://cryptoslate.com/feed/",
]

# === PUMP.FUN / МЕМКОИНЫ / АЛЬТКОИНЫ ===
PUMP_FEEDS = [
    "https://www.coingecko.com/en/news/feed",
    "https://cryptonews.com/news/altcoins/feed/",
    "https://www.cryptoninjas.net/feed/",
]

# === ГЛОБАЛЬНЫЕ НОВОСТИ (Финансы, Экономика, Технологии) ===
GLOBAL_FEEDS = [
    "https://feeds.reuters.com/reuters/businessNews",
    "https://feeds.bloomberg.com/markets/news.rss",
    "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=100003114",
    "https://feeds.finance.yahoo.com/rss/2.0/headline?s=^GSPC&region=US&lang=en-US",
    "https://rss.nytimes.com/services/xml/rss/nyt/Business.xml",
    "https://feeds.bbci.co.uk/news/business/rss.xml",
    "https://techcrunch.com/feed/",
    "https://www.theverge.com/rss/index.xml",
]

# Категории с весами (какие постить чаще)
CATEGORIES = {
    'crypto': {'feeds': CRYPTO_FEEDS, 'weight': 50, 'emoji': ''},
    'pump': {'feeds': PUMP_FEEDS, 'weight': 20, 'emoji': '🚀'},
    'global': {'feeds': GLOBAL_FEEDS, 'weight': 30, 'emoji': ''},
}

def get_random_category():
    """Выбираем категорию на основе весов"""
    categories = list(CATEGORIES.keys())
    weights = [CATEGORIES[c]['weight'] for c in categories]
    return random.choices(categories, weights=weights, k=1)[0]

def get_news_from_category(category):
    """Получаем новости из выбранной категории"""
    feeds = CATEGORIES[category]['feeds']
    all_entries = []
    headers = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'}
    
    for url in feeds:
        try:
            response = requests.get(url, headers=headers, timeout=10)
            if response.status_code == 200:
                feed = feedparser.parse(response.content)
                for entry in feed.entries[:3]:
                    title = entry.get('title', '')
                    link = entry.get('link', '')
                    source = feed.feed.get('title', 'News')
                    if title and len(title) > 15:
                        all_entries.append({
                            'title': title,
                            'link': link,
                            'source': source,
                            'category': category
                        })
        except Exception as e:
            print(f"⚠️ Error with {url}: {e}")
    
    if all_entries:
        return random.choice(all_entries)
    return None

def generate_image_url(title, category):
    """Генерируем картинку под категорию"""
    if category == 'crypto':
        style = "cryptocurrency trading dashboard, dark neon theme, bitcoin chart, candlesticks, glowing effects, professional financial, 4k, cinematic"
    elif category == 'pump':
        style = "rocket launching to moon, meme coins, dogecoin, shiba inu, colorful explosion, neon lights, crypto pump, 4k, vibrant"
    else:  # global
        style = "global financial markets, stock exchange, world map with data, professional business news, dark theme, 4k, cinematic"
    
    prompt = urllib.parse.quote(f"{style}, {title[:40]}")
    seed = random.randint(1, 99999)
    return f"https://image.pollinations.ai/prompt/{prompt}?width=1200&height=675&model=flux&nologo=true&seed={seed}"

def format_post(news):
    """Форматируем пост под категорию"""
    category = news['category']
    emoji = CATEGORIES[category]['emoji']
    title = news['title'].strip()
    
    if len(title) > 150:
        title = title[:147] + "..."
    
    if category == 'crypto':
        caption = (
            f"{emoji} <b>CRYPTO NEWS</b>\n\n"
            f"{title}\n\n"
            f"📊 Source: {news['source']}\n"
            f"🔗 <a href='{news['link']}'>Read more</a>\n\n"
            f"#Crypto #Bitcoin #Ethereum #TheCryptoPulse"
        )
    elif category == 'pump':
        caption = (
            f"{emoji} <b>ALTCOINS & MEMES</b>\n\n"
            f"{title}\n\n"
            f"📊 Source: {news['source']}\n"
            f"🔗 <a href='{news['link']}'>Read more</a>\n\n"
            f"#Altcoins #Memecoins #Pump #CryptoGems"
        )
    else:  # global
        caption = (
            f"{emoji} <b>GLOBAL MARKETS</b>\n\n"
            f"{title}\n\n"
            f"📊 Source: {news['source']}\n"
            f" <a href='{news['link']}'>Read more</a>\n\n"
            f"#Finance #Markets #Economy #GlobalNews"
        )
    
    return caption

def send_to_telegram(news):
    """Отправляем пост в Telegram"""
    caption = format_post(news)
    image_url = generate_image_url(news['title'], news['category'])
    
    url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendPhoto"
    data = {
        "chat_id": CHANNEL_ID,
        "photo": image_url,
        "caption": caption,
        "parse_mode": "HTML"
    }
    
    response = requests.post(url, json=data, timeout=30)
    
    if response.status_code == 200:
        print(f"✅ Posted {news['category']} news to Telegram!")
        return True
    else:
        print(f"❌ Telegram error: {response.text}")
        return False

def main():
    print("🚀 CryptoPulse Bot started!")
    
    # Выбираем случайную категорию
    category = get_random_category()
    print(f"📂 Category: {category}")
    
    # Получаем новость
    news = get_news_from_category(category)
    
    if not news:
        print("⚠️ No news found, trying other categories...")
        # Пробуем другие категории
        for cat in CATEGORIES.keys():
            if cat != category:
                news = get_news_from_category(cat)
                if news:
                    break
    
    if not news:
        print(" No news found from any source")
        return
    
    print(f"📰 News: {news['title'][:60]}...")
    send_to_telegram(news)

if __name__ == "__main__":
    main()
